; Etch and overgrow 2026, 1D polariton waveguides for single-shot space-time vortices
; generated by pattern_creator/projects/eno_run_2026/vortex_waveguides.py
; design etch depth 18 meV photon confinement; widths 1, 1.2, 1.4, 1.6, 1.8, 2, 3 um
; lengths 250, 350, 450 um per width (one top-aligned row; user: >= 250 um), pitch 19 um, guide axis y
; units nm; exposed area = mesa (guide stripe); exact RECTs, I 16, C 100 (as 2024/2026 EnO structures)
; left column: 2024 overlap-series dimers, 2024 50 x 50 um mesa, chip numbers + arrows (as shc_field)
; parameters in vwg_field_devices.csv
; grid 3 x 2 fields, pitch 550 x 550 um, field x/y index labels from numbers_vwg.pat

current = 25000

origin = 0, 0
x = 0
y = 0
stage

for m = 1 to 2
x = 0
for n = 1 to 3
stage

sfile = vwg_field
draw(vwg_field_f0_wg_w1p000_l250)
draw(vwg_field_f0_wg_w1p000_l350)
draw(vwg_field_f0_wg_w1p000_l450)
draw(vwg_field_f0_wg_w1p200_l250)
draw(vwg_field_f0_wg_w1p200_l350)
draw(vwg_field_f0_wg_w1p200_l450)
draw(vwg_field_f0_wg_w1p400_l250)
draw(vwg_field_f0_wg_w1p400_l350)
draw(vwg_field_f0_wg_w1p400_l450)
draw(vwg_field_f0_wg_w1p600_l250)
draw(vwg_field_f0_wg_w1p600_l350)
draw(vwg_field_f0_wg_w1p600_l450)
draw(vwg_field_f0_wg_w1p800_l250)
draw(vwg_field_f0_wg_w1p800_l350)
draw(vwg_field_f0_wg_w1p800_l450)
draw(vwg_field_f0_wg_w2p000_l250)
draw(vwg_field_f0_wg_w2p000_l350)
draw(vwg_field_f0_wg_w2p000_l450)
draw(vwg_field_f0_wg_w3p000_l250)
draw(vwg_field_f0_wg_w3p000_l350)
draw(vwg_field_f0_wg_w3p000_l450)
draw(vwg_field_f0_ref_overlap_dimers_2024)
draw(vwg_field_f0_ref_mesa_50um_2024)
draw(vwg_field_f0_ref_arrows_right)
draw(vwg_field_f0_ref_arrows_up)
draw(vwg_field_f0_labels)

sfile = numbers_vwg
idraw(nbr_x_, n)
idraw(nbr_y_, m)

+x = 550
next n
+y = 550
next m

END
