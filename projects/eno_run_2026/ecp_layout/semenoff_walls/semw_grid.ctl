; Etch and overgrow 2026 (3-QW wafer), Semenoff mass domain walls (valley-Hall transport), second field
; generated by pattern_creator/projects/eno_run_2026/semenoff_walls.py
; target etch depth 15.5 meV; d_mean 1800 nm, v = a/d_mean = 0.950 (bulk design), eta rows 0.29 / 0.22
; columns: chain LL, chain SS, dimer LL, dimer SS walls (along x, through the middle of each lattice)
; below the wall A large, above swapped (or vice versa, see devices csv); whole pillars only
; units nm; exposed area = pillar mesas; 25 nm raster, I 16, C 100 (as 2024 EnO lattices); explicit disks
; grid 3 x 2 fields, pitch 550 x 550 um, field x/y index labels from numbers_semw.pat

current = 25000

origin = 0, 0
x = 0
y = 0
stage

for m = 1 to 2
x = 0
for n = 1 to 3
stage

sfile = semw_field
draw(semw_field_f0_dw_chainLL_e0p290)
draw(semw_field_f0_dw_chainSS_e0p290)
draw(semw_field_f0_dw_dimerLL_e0p290)
draw(semw_field_f0_dw_dimerSS_e0p290)
draw(semw_field_f0_dw_chainLL_e0p220)
draw(semw_field_f0_dw_chainSS_e0p220)
draw(semw_field_f0_dw_dimerLL_e0p220)
draw(semw_field_f0_dw_dimerSS_e0p220)
draw(semw_field_f0_ref_arrows_right)
draw(semw_field_f0_ref_arrows_up)
draw(semw_field_f0_labels)

sfile = numbers_semw
idraw(nbr_x_, n)
idraw(nbr_y_, m)

+x = 550
next n
+y = 550
next m

END
